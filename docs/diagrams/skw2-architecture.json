  "cards": [
    {
      "dot": "cyan",
      "title": "Two Gates, One Backend",
      "items": [
        "gates/api and gates/ws share the same Iggy stream, ping topic, and back topic",
        "Each gate joins the back topic under its own consumer-group name so replies aren't split between them",
        "ws_gate authenticates once per connection; api gate verifies a signature on every request"
      ]
    },
    {
      "dot": "emerald",
      "title": "Auth Service",
      "items": [
        "Owns the entities/roles Postgres schema",
        "Exposes only GetKeyById over internal HTTP",
        "Called by both gates, never by services directly"
      ]
    },
    {
      "dot": "amber",
      "title": "Background Work",
      "items": [
        "ping-stream-service also increments a Redis counter on every Ping call",
        "ping-mq-service drains a RabbitMQ queue independently of the Iggy request path",
        "gates/ws and ping-mq-service are not yet in docker-compose"
      ]
    }
  ]
}