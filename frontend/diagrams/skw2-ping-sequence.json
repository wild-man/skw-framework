{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Signed Ping Round Trip (API Gate)",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1000,
      600
    ],
    "output": "skw2-ping-sequence.html"
  },
  "participants": [
    {
      "id": "client",
      "type": "external",
      "label": "Client",
      "sublabel": "signs request"
    },
    {
      "id": "gate",
      "type": "backend",
      "label": "API Gate",
      "sublabel": "verifies, correlates"
    },
    {
      "id": "auth",
      "type": "security",
      "label": "Auth Service",
      "sublabel": "GetKeyById"
    },
    {
      "id": "bus",
      "type": "messagebus",
      "label": "Iggy Bus",
      "sublabel": "ping-signed, gate-back"
    },
    {
      "id": "ping",
      "type": "backend",
      "label": "Ping Service",
      "sublabel": "ping-stream-service"
    }
  ],
  "segments": [
    {
      "from": 165,
      "to": 292,
      "label": "Request + auth"
    },
    {
      "from": 300,
      "to": 468,
      "label": "Async round trip"
    }
  ],
  "messages": [
    {
      "id": "post-ping",
      "from": "client",
      "to": "gate",
      "y": 190,
      "label": "POST /ping/signed",
      "variant": "emphasis"
    },
    {
      "id": "get-key",
      "from": "gate",
      "to": "auth",
      "y": 222,
      "label": "GetKeyById (on cache miss)",
      "variant": "security"
    },
    {
      "id": "key-reply",
      "from": "auth",
      "to": "gate",
      "y": 254,
      "label": "public_key + enabled",
      "variant": "return",
      "note": "cached 60s; gate checks ed25519 + Ts window"
    },
    {
      "id": "publish-req",
      "from": "gate",
      "to": "bus",
      "y": 314,
      "label": "publish request",
      "variant": "emphasis"
    },
    {
      "id": "deliver-req",
      "from": "bus",
      "to": "ping",
      "y": 346,
      "label": "deliver (consumer group)",
      "variant": "default"
    },
    {
      "id": "publish-resp",
      "from": "ping",
      "to": "bus",
      "y": 378,
      "label": "reply on back topic",
      "variant": "default"
    },
    {
      "id": "broadcast-resp",
      "from": "bus",
      "to": "gate",
      "y": 410,
      "label": "matched by signature",
      "variant": "return"
    },
    {
      "id": "http-resp",
      "from": "gate",
      "to": "client",
      "y": 442,
      "label": "200 Ping JSON",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "gate",
      "from": 222,
      "to": 468,
      "type": "backend"
    },
    {
      "participant": "auth",
      "from": 217,
      "to": 259,
      "type": "security"
    },
    {
      "participant": "ping",
      "from": 346,
      "to": 383,
      "type": "backend"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Happy Path",
      "items": [
        "The gate verifies the signature and the Ts window itself; auth only serves the key",
        "The request signature doubles as the Iggy correlation id"
      ]
    },
    {
      "dot": "rose",
      "title": "Correlation",
      "items": [
        "The gate subscribes to the back-topic broadcast before publishing",
        "No reply within 30s answers 504; a lagging receiver keeps waiting"
      ]
    }
  ]
}
