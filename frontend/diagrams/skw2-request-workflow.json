{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Signed Request Handling Workflow",
    "quality_profile": "showcase",
    "output": "skw2-request-workflow.html"
  },
  "lanes": [
    {
      "id": "ui",
      "label": "Client"
    },
    {
      "id": "gate",
      "label": "Gate"
    },
    {
      "id": "security",
      "label": "Auth & Replay Checks"
    },
    {
      "id": "backend",
      "label": "Backend Service (Iggy)"
    }
  ],
  "phases": [
    {
      "id": "intake",
      "label": "Intake",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "authn",
      "label": "AuthN + replay window",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "roundtrip",
      "label": "Async round trip",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "request",
    "route",
    "verify_sig",
    "check_ts",
    "publish",
    "service_reply",
    "response"
  ],
  "nodes": [
    {
      "id": "request",
      "lane": "ui",
      "col": 0,
      "type": "external",
      "label": "Signed Request",
      "sublabel": "API-KEY + PAYLOAD-SIGNATURE",
      "width": 156
    },
    {
      "id": "route",
      "lane": "gate",
      "col": 1,
      "type": "backend",
      "label": "Route & Parse",
      "sublabel": "first two path segments",
      "width": 156
    },
    {
      "id": "verify_sig",
      "lane": "security",
      "col": 2,
      "type": "security",
      "label": "Verify Signature",
      "sublabel": "GetKeyById (60s cache) + ed25519",
      "width": 156
    },
    {
      "id": "rejected",
      "lane": "gate",
      "col": 2,
      "type": "security",
      "label": "403 Forbidden",
      "sublabel": "bad signature or key",
      "width": 156
    },
    {
      "id": "check_ts",
      "lane": "security",
      "col": 3,
      "type": "security",
      "label": "Check Ts Window",
      "sublabel": "within 30s of gate clock",
      "width": 156
    },
    {
      "id": "outdated",
      "lane": "gate",
      "col": 3,
      "type": "security",
      "label": "409 Conflict",
      "sublabel": "outdated or future Ts",
      "width": 156
    },
    {
      "id": "publish",
      "lane": "backend",
      "col": 4,
      "type": "messagebus",
      "label": "Publish to Topic",
      "sublabel": "signature + api-key headers",
      "width": 156
    },
    {
      "id": "service_reply",
      "lane": "backend",
      "col": 5,
      "type": "messagebus",
      "label": "Service Reply",
      "sublabel": "back topic, same signature",
      "width": 156
    },
    {
      "id": "response",
      "lane": "ui",
      "col": 5,
      "type": "frontend",
      "label": "HTTP Response",
      "sublabel": "200, 201/202 or error",
      "width": 156
    }
  ],
  "edges": [
    {
      "id": "request-route",
      "from": "request",
      "to": "route",
      "variant": "default"
    },
    {
      "id": "route-verify",
      "from": "route",
      "to": "verify_sig",
      "variant": "default"
    },
    {
      "id": "verify-rejected",
      "from": "verify_sig",
      "to": "rejected",
      "label": "invalid",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "verify-ts",
      "from": "verify_sig",
      "to": "check_ts",
      "label": "valid",
      "variant": "emphasis"
    },
    {
      "id": "ts-outdated",
      "from": "check_ts",
      "to": "outdated",
      "label": "outside window",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "ts-publish",
      "from": "check_ts",
      "to": "publish",
      "label": "fresh",
      "variant": "emphasis"
    },
    {
      "id": "publish-reply",
      "from": "publish",
      "to": "service_reply",
      "label": "consumer group",
      "variant": "default"
    },
    {
      "id": "reply-response",
      "from": "service_reply",
      "to": "response",
      "label": "signature match, 30s timeout",
      "variant": "emphasis",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Checks Live in the Gate",
      "items": [
        "The auth service only serves GetKeyById; both gates verify ed25519 locally",
        "A valid signature over an old Ts is refused with 409 before anything is published"
      ]
    },
    {
      "dot": "emerald",
      "title": "Correlation",
      "items": [
        "The request signature doubles as the correlation id on Iggy",
        "No reply within 30s answers 504; a provisional reply ends an HTTP request with 201/202"
      ]
    }
  ]
}
