  "cards": [
    {
      "dot": "cyan",
      "title": "Two Gates, One Bus",
      "items": [
        "Both gates publish to {service}-{topic_type}-{VERSION} and read replies from gate-back-{VERSION}",
        "Each gate reads replies in its own consumer group: consumer-{service}-{topic}",
        "Gates verify ed25519 signatures and refuse an outdated Ts with 409"
      ]
    },
    {
      "dot": "amber",
      "title": "Background Work",
      "items": [
        "PingCreated/PingAccepted reply 201/202 at once; ping-mq sends the final 200 on the back topic",
        "Dialog Ask stores a Pending answer; dialog-mq calls the LLM and clients poll GetDialog",
        "Workers run tasks concurrently up to the queue prefetch"
      ]
    },
    {
      "dot": "emerald",
      "title": "Auth Service",
      "items": [
        "Owns the entities/roles schema and issues keys (CreateKey)",
        "Serves GetKeyById to the gates; services never call it",
        "Does not verify signatures itself"
      ]
    }
  ]
