{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Signed Request Lifecycle",
    "output": "skw2-request-lifecycle.html",
    "quality_profile": "showcase"
  },
  "mainPath": [
    "received",
    "verifying",
    "publishing",
    "awaiting_reply",
    "completed"
  ],
  "states": [
    {
      "id": "received",
      "type": "start",
      "label": "Received",
      "sublabel": "routed by path",
      "step": "01"
    },
    {
      "id": "verifying",
      "type": "decision",
      "label": "Auth Checks",
      "sublabel": "ed25519 + Ts window",
      "step": "02"
    },
    {
      "id": "publishing",
      "type": "active",
      "label": "Published",
      "sublabel": "to Iggy, signed headers",
      "step": "03"
    },
    {
      "id": "awaiting_reply",
      "type": "waiting",
      "label": "Awaiting Reply",
      "sublabel": "back topic, 30s timeout",
      "step": "04"
    },
    {
      "id": "completed",
      "type": "success",
      "label": "Responded",
      "sublabel": "200 or 201/202",
      "step": "05"
    },
    {
      "id": "refused",
      "type": "failure",
      "label": "Refused",
      "sublabel": "403 bad sig, 409 old Ts"
    },
    {
      "id": "timed_out",
      "type": "failure",
      "label": "504 Timed Out",
      "sublabel": "no reply in 30s"
    },
    {
      "id": "service_error",
      "type": "failure",
      "label": "Service Error",
      "sublabel": "err-response-code"
    }
  ],
  "transitions": [
    {
      "id": "received-verifying",
      "from": "received",
      "to": "verifying"
    },
    {
      "id": "verifying-publishing",
      "from": "verifying",
      "to": "publishing",
      "label": "checks pass",
      "variant": "emphasis"
    },
    {
      "id": "verifying-refused",
      "from": "verifying",
      "to": "refused",
      "label": "check fails",
      "variant": "security"
    },
    {
      "id": "publishing-waiting",
      "from": "publishing",
      "to": "awaiting_reply",
      "label": "subscribed"
    },
    {
      "id": "waiting-completed",
      "from": "awaiting_reply",
      "to": "completed",
      "label": "reply ok",
      "variant": "emphasis"
    },
    {
      "id": "waiting-timeout",
      "from": "awaiting_reply",
      "to": "timed_out",
      "label": "no reply",
      "variant": "security"
    },
    {
      "id": "waiting-service-error",
      "from": "awaiting_reply",
      "to": "service_error",
      "label": "reply has error",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Outcomes",
      "items": [
        "A bad signature (403) or an outdated Ts (409) is refused before anything is published",
        "No reply within 30s answers 504 even if no service failed",
        "Over ws a 201/202 keeps the request pending until its final reply"
      ]
    }
  ]
}
