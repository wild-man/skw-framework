{
  "envOverrides": {
    "/iggy/url": "IGGY_URL",
    "/rabbitmq/url": "RABBITMQ_URL",
    "/llm/url": "LLM_URL",
    "/llm/apiKey": "LLM_API_KEY"
  },
  "service": {
    "name": "skw-dialog-service",
    "rootKey": "01a01500-98d5-71fc-9038-71acb78d61c4",
    "topicTypes": [
      "signed"
    ]
  },
  "iggy": {
    "url": "iggy+quic://iggy:Secret123!@localhost:8080",
    "streamPrefix": "api-gate-stream"
  },
  "redis": {
    "url": "redis://skw:password@localhost:6379"
  },
  "rabbitmq": {
    "url": "amqp://rabbitmq:Secret123!@localhost:5672",
    "queues": [
      {
        "name": "dialog-ask",
        "prefetch": 4
      }
    ]
  },
  "postgres": {
    "master": {
      "url": "postgres://skw:password@localhost:5432/skw",
      "createServiceSchema": true,
      "setSearchPathByService": true
    },
    "slave": {
      "url": "postgres://skw:password@localhost:5432/skw",
      "createServiceSchema": false,
      "setSearchPathByService": true
    }
  },
  "llm": {
    "url": "http://localhost:11434/v1",
    "apiKey": "",
    "defaultModel": "qwen3:4b-instruct",
    "models": [
      "qwen3:4b-instruct"
    ],
    "timeoutSecs": 180,
    "maxAttempts": 3,
    "reasoningEffort": "none",
    "codeSearch": {
      "root": "/home/wildman/Sources/skw2",
      "maxSteps": 6,
      "denyDirs": [
        "target",
        "docker",
        "node_modules",
        "pgdata"
      ],
      "denyFiles": [
        "dev.json",
        "local.json",
        "local-signed.json",
        "r.txt",
        "v.txt"
      ],
      "denyExtensions": [
        "pem",
        "key",
        "crt",
        "p12",
        "env",
        "lock",
        "log"
      ],
      "diagrams": {
        "dir": "frontend/diagrams",
        "urlPrefix": "diagrams/"
      }
    },
    "profile": {
      "file": "./frontend/index.html",
      "name": "Sergey Kutsenko",
      "endMarker": "<button class=\"chat-fab\""
    }
  }
}
